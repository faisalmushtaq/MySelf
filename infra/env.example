# Copy to .env beside docker-compose.yml and fill in. Never commit the result.
#
# Generate each secret with:  openssl rand -base64 32

# The hostname you pointed at this box. TLS is issued for it automatically.
DOMAIN=myself.example.org

# Postgres. The password is only ever used inside the compose network.
POSTGRES_USER=myself
POSTGRES_DB=myself
POSTGRES_PASSWORD=

# Keycloak's first administrator. Sign in at https://$DOMAIN/auth/, create your
# own account, give it the owner role, then delete or disable this one.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Which browser origins may call the API. The researcher view's URL, exactly —
# scheme and host, no trailing slash. Comma-separate if there is more than one.
ALLOWED_ORIGINS=https://faisalmushtaq.github.io

# The OIDC client id you create in Keycloak for the researcher view.
OIDC_AUDIENCE=myself

# Where nightly dumps are copied. Anything rclone can reach.
BACKUP_REMOTE=
