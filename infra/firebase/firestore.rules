rules_version = '2';

/*
 * Deployed by CI, since this commit.
 *
 * These rules were watched by the workflow's path filter but never handed to a
 * deploy: an edit landed on main, the run went green, and the project kept the
 * old rules. A rules file that is not deployed is a control that exists only in
 * the repository — and the gap is invisible exactly because the run passes.
 * `.github/workflows/firebase.yml` now ships them when they change.
 */

/**
 * MySelf — research project rules.
 *
 * On Postgres the access control was a role with no grant. Here it is this
 * file, so it is written to be read: every rule states who and why, and the
 * rules test suite exercises each one from both sides — the caller who should
 * pass and the caller who should not.
 *
 * Three kinds of caller:
 *   - iPads, which carry a `device` claim. They may add sittings and read
 *     nothing. A stolen device cannot read the study back.
 *   - people, who carry a `role` claim of owner, researcher or analyst.
 *   - everybody else, who gets nothing.
 *
 * MySelf Studio adds one more, and one exception to the last line. People on
 * the Studio list are recognised by their verified Google address, not by a
 * claim (see "MySelf Studio" below). And two Studio documents are public by
 * `get`: the pointer to the live release and the release it points at, which
 * is what a participant's iPad used to receive compiled into the app.
 *
 * Study spaces (D-56, docs/16 §11) add a third public document: the study's
 * own, `studies/{study}`, its title and whether it is open. Everything below
 * is scoped by the study in the path, so a place on one study's list is no
 * place on another's; the `owner`, `researcher` and `analyst` claims are the
 * project's, and reach every study, as they reached the only one before.
 *
 * Participants never authenticate at all: the iPad is the authenticated party,
 * not the child using it.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isDevice() {
      return signedIn() && request.auth.token.get('device', false) == true;
    }

    // A person, as opposed to an iPad. Devices are deliberately excluded from
    // every read path below by this distinction.
    function isPerson() {
      return signedIn() && !isDevice() && role() in ['owner', 'researcher', 'analyst'];
    }

    function canWrite() {
      return role() in ['owner', 'researcher'];
    }

    function isOwner() {
      return role() == 'owner';
    }

    // The device's own study, so one site's iPad cannot post into another's.
    function deviceStudy() {
      return request.auth.token.get('study', '');
    }

    // ── MySelf Studio: who is on the list (docs/16 §5.7) ───────────────────
    //
    // The Studio does not use the role claim, with one exception below. A claim
    // outlives its revocation for as long as the token lasts, up to an hour,
    // and granting one is the owner's job. The Studio's list is run by its own
    // admins and has to bite on the very next request, so a person's Studio
    // role is read from server-written documents every time, keyed by the
    // address Google verified. No client can write those documents, so no
    // client can grant itself anything.
    //
    // A `researcher` or `analyst` claim therefore gives no Studio access on its
    // own: reading sittings and changing the survey children see are different
    // trusts, and the second is given by name.

    // Someone Google has vouched for. The address is the key to the list, so it
    // has to be one the person signing in has proved is theirs, through the one
    // sign-in the Studio offers. A token from any other provider is refused
    // whatever it says about an address: an iPad signs in anonymously, and
    // providers differ in whether, and how, they check that an address belongs
    // to whoever is using it. The provider is also a field no server-minted
    // custom token can set, so a custom token carrying somebody's address
    // cannot pass for them.
    function verifiedGoogle() {
      return signedIn()
        && !isDevice()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com'
        && request.auth.token.get('email', null) is string;
    }

    // The list is keyed by lower-cased address (`paths.studioMember`), so one
    // person is not a member under one spelling and a stranger under another.
    // Anything the Studio stamps with "who" (`updatedByEmail` on the draft,
    // `email` on presence) is this same key, so it can be matched to the list.
    function emailKey() {
      return request.auth.token.email.lower();
    }

    // MUST MATCH `ROLE_LEVEL` in packages/studio/src/contract.ts, which this
    // file cannot import; the Studio rules tests hold the two together. Each
    // role includes everything below it. A value that is not a known role (a
    // typo, a missing field) is 0, not an error that could deny something the
    // person's other route to the Studio grants.
    function roleLevel(r) {
      return r == 'admin' ? 4
        : r == 'publisher' ? 3
        : r == 'editor' ? 2
        : r == 'viewer' ? 1
        : 0;
    }

    // The person's own entry on the list, if there is one.
    function memberPath(study) {
      return /databases/$(database)/documents/studies/$(study)/studioMembers/$(emailKey());
    }

    function memberLevel(study) {
      return exists(memberPath(study)) ? roleLevel(get(memberPath(study)).data.get('role', '')) : 0;
    }

    // A domain rule admits every verified account at a managed Workspace
    // domain. Matched on the whole domain and nothing else: an address with
    // more than one "@" is not split at a convenient one, and
    // "brainpop.com.example.net" is not "brainpop.com". A config with no rules,
    // or a malformed one, admits nobody rather than failing the request.
    function domainLevel(study) {
      let parts = emailKey().split('@');
      let config = /databases/$(database)/documents/studies/$(study)/studioAccess/config;
      let domains = exists(config) ? get(config).data.get('domains', {}) : {};
      return parts.size() == 2 && domains is map ? roleLevel(domains.get(parts[1], '')) : 0;
    }

    // 0 (nothing) to 4 (admin). An iPad is always 0, whatever else its token
    // carries. The existing owner is an admin, so there is somebody who can add
    // the first member from Settings (docs/16 §5.7).
    //
    // A PERSONAL ENTRY DECIDES, when there is one; the domain rule is only the
    // default for people nobody has listed. That is what lets an admin give one
    // person at an admitted domain less than the domain's role — a student at a
    // domain of editors, say — instead of having to choose between the domain
    // rule and listing everyone by hand.
    //
    // At most two documents are read, and the rules read each once however
    // often a request asks, so every Studio rule stays far inside the ten-read
    // limit. Each read is billed, which is the price of a revocation that takes
    // effect at once.
    function studioLevel(study) {
      return isDevice() ? 0
        : isOwner() ? 4
        : verifiedGoogle() ? (exists(memberPath(study)) ? memberLevel(study) : domainLevel(study))
        : 0;
    }

    match /studies/{study} {

      // ── The study itself: the registry (D-56, docs/16 §11.4) ─────────────
      // Its title, whether it is open, and when. PUBLIC BY `get`, so an iPad
      // given a link can tell a closed or unknown study before anybody types a
      // code — which is why it holds nothing a poster could not: the creator
      // is a uid here and an address only in the Studio audit trail. LISTED
      // only by the project's people, so the dashboard can find every study
      // and a stranger with the survey's URL cannot enumerate them. Written
      // only by the owner-only functions that create, rename, close and
      // reopen a study; nobody deletes one. These rules apply to the document
      // alone: every collection beneath it keeps its own rules below.
      allow get: if true;
      allow list: if isPerson();
      allow write: if false;

      // ── Sittings ────────────────────────────────────────────────────────
      match /sessions/{sessionId} {
        // People read; devices never do.
        allow read: if isPerson();

        // A device may create a sitting that does not exist yet, in its own
        // study, stamped with its own id. Create-only is what makes a retried
        // upload safe: the second attempt is refused rather than doubling
        // anything, and the client treats "already exists" as success.
        allow create: if isDevice()
          && study == deviceStudy()
          && request.resource.data.deviceId == request.auth.uid
          && request.resource.data.sessionId == sessionId
          && request.resource.data.study == study;

        // Only the device that created a sitting may add to it — the case
        // where a participant resumes and finishes on the same iPad. A second
        // device writing here is exactly the merge this platform must never
        // make, so it is refused at the rule and the client files a quarantine
        // record instead.
        allow update: if isDevice()
          && resource.data.deviceId == request.auth.uid
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.releaseHash == resource.data.releaseHash;

        // Researchers may mark a sitting quarantined, and nothing else about
        // it. The raw log is the record; no person edits it, ever.
        allow update: if canWrite()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quarantined']);

        // Nobody deletes. Withdrawal is a documented workflow that writes a
        // tombstone, not an ad-hoc delete from a console.
        allow delete: if false;

        match /chunks/{chunk} {
          allow read: if isPerson();
          allow create: if isDevice() && study == deviceStudy();
          allow update, delete: if false;
        }
      }

      // ── Quarantine ──────────────────────────────────────────────────────
      // A device whose write was refused files the copy it was holding here,
      // so both versions survive and a human can compare them.
      match /quarantine/{entry} {
        allow read: if isPerson();
        allow create: if isDevice() && study == deviceStudy();
        allow update: if canWrite();
        allow delete: if false;
      }

      // ── Corrections and twin splits ─────────────────────────────────────
      // Both change who a sitting belongs to, so both are researcher-level and
      // both are append-then-withdraw rather than edit-in-place: the history of
      // what was believed about a participant is itself worth keeping.
      match /corrections/{correction} {
        allow read: if isPerson();
        allow create: if canWrite() && request.resource.data.wrongCode != request.resource.data.rightCode;
        allow update: if canWrite()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawnAt', 'withdrawnBy']);
        allow delete: if false;
      }

      match /assignments/{sessionId} {
        allow read: if isPerson();
        allow write: if canWrite();
      }

      // ── Devices ─────────────────────────────────────────────────────────
      // Enrolment happens in a Cloud Function using the admin SDK, which is
      // not subject to these rules. Nothing a browser can do creates a device.
      match /devices/{deviceId} {
        allow read: if isOwner();
        allow write: if false;
      }

      // ── Audit ───────────────────────────────────────────────────────────
      // Append-only for anyone who can write, readable only by an owner. Not
      // editable by anybody, including the person who wrote the entry.
      match /audit/{entry} {
        allow read: if isOwner();
        allow create: if signedIn();
        allow update, delete: if false;
      }

      /**
       * Narrative runs — a young person's own words about their experience.
       *
       * NO CLIENT MAY WRITE ONE. They arrive through the saveNarrative
       * function, which uses the Admin SDK and so passes these rules by; that
       * is the point. A tester holding a link key is not signed in at all and
       * could not write here under any rule, and a device that could write
       * directly could also overwrite somebody else's run.
       *
       * Reading is for people, not devices: an iPad that has finished a
       * sitting has no business reading back what any child has said,
       * including the one in front of it.
       */
      match /narratives/{sessionId} {
        allow read: if isPerson();
        allow write: if false;
      }

      /**
       * MySelf Studio — docs/16 §5.2.
       *
       * Everything here is about the survey, not about anybody's answers: a
       * sitting keeps pointing at the release it was collected under by hash,
       * and nothing below can change a sitting or what it points at.
       *
       * A BROWSER WRITES TWO THINGS HERE AND NOTHING ELSE: the working draft,
       * one revision at a time, and its own presence marker. Publishing,
       * restoring, rolling back and managing the list go through functions,
       * which check the list again themselves and write the audit row in the
       * same transaction as the change, so none of it can happen without a
       * record.
       */

      // ── Studio: surveys and their drafts ───────────────────────────────
      match /surveys/{surveyId} {
        // The survey's summary: its title, which version is live, who has
        // edited since. Written only by functions, as a side effect of the
        // actions they audit.
        allow read: if studioLevel(study) >= 1;
        allow write: if false;

        // The draft is one document, `current`, and it only ever moves
        // forward by one revision. That is the whole of the concurrency
        // control (docs/16 R10): a save made against the revision somebody
        // else has already replaced asks for the same next number they took,
        // is refused, and the editor shows both versions instead of quietly
        // overwriting one of them.
        //
        // Who and when are the caller's own uid, the caller's list key (the
        // lower-cased address, see emailKey) and the server's clock, never
        // values the client chose. Where the draft came from (`basedOn`), what
        // it is (`surveyId`) and when it began are the functions' to set, so
        // an editor can change the content and nothing about its provenance.
        //
        // No client creates or deletes a draft: a survey is created, and a
        // version restored into it, by functions that audit it. The 900,000
        // character ceiling (MAX_DRAFT_CHARS) leaves room under Firestore's
        // 1 MiB document limit for the rest of the document.
        match /draft/{docId} {
          allow read: if studioLevel(study) >= 1;
          allow update: if studioLevel(study) >= 2
            && docId == 'current'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['content', 'revision', 'updatedAt', 'updatedBy', 'updatedByEmail'])
            && request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedByEmail == emailKey()
            && request.resource.data.updatedAt == request.time
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 900000;
          allow create, delete: if false;
        }

        // Published versions are immutable. Only functions write one: the
        // publish, after running on the server the same validation and gate
        // the editor shows, and the one-time import of the releases already
        // in the repository.
        match /versions/{version} {
          allow read: if studioLevel(study) >= 1;
          allow write: if false;
        }

        // Who else has the editor open, so two people know before they
        // collide rather than after. Each person writes only their own marker,
        // stamped with their own uid, address and the server's clock, so one
        // editor cannot make it look as if somebody else is at work. Taking
        // your own marker down needs only that it is yours: somebody removed
        // from the list while the editor was open can still clear their name
        // from it, and it can only ever remove what that account wrote.
        match /presence/{uid} {
          allow read: if studioLevel(study) >= 1;
          allow create, update: if studioLevel(study) >= 2
            && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'focus'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == emailKey()
            && request.resource.data.at == request.time
            && (request.resource.data.get('focus', null) == null
                || request.resource.data.focus is string);
          allow delete: if signedIn() && uid == request.auth.uid;
        }
      }

      // ── Studio: what participants load (PUBLIC) ────────────────────────
      // The only documents in the project that anyone may read signed out.
      // The pointer says which release is live (hash, version, generation);
      // a public release is the manifest itself, immutable and keyed by the
      // hex of its own hash, which the device recomputes before running it.
      // That manifest is exactly what every participant already downloads
      // inside the app today, so making it readable discloses nothing new.
      //
      // `get` only, never `list`, for the public. A device asks for the one
      // survey it runs and the one hash that pointer names; nobody needs to
      // enumerate what else exists, so a stranger cannot. The project's people
      // may list a study's pointers (D-56): that is how the dashboard finds
      // the surveys with a live version in each study, and they already read
      // every sitting filed under them. Written only by the publish, rollback
      // and import functions, in the transaction that audits them.
      match /published/{surveyId} {
        allow get: if true;
        allow list: if isPerson();
        allow write: if false;
      }

      match /publicReleases/{hashHex} {
        allow get: if true;
        allow list: if false;
        allow write: if false;
      }

      // ── Studio: the list itself ────────────────────────────────────────
      // Admins see everyone. Anyone else Google has verified may read their
      // own entry, and only their own, so the Studio can tell them what role
      // they have, and nobody learns who else has access by guessing
      // addresses.
      // Nobody writes here from a browser, not even an admin: a change of
      // access goes through a function that audits it, or the studio-access
      // command for the very first admin.
      match /studioMembers/{email} {
        allow get: if (verifiedGoogle() && email == emailKey()) || studioLevel(study) >= 4;
        allow list: if studioLevel(study) >= 4;
        allow write: if false;
      }

      // The domain rule, e.g. { "brainpop.com": "editor" }. Admins only: it
      // is part of the list.
      match /studioAccess/{doc} {
        allow read: if studioLevel(study) >= 4;
        allow write: if false;
      }

      // The Studio's audit trail, separate from `audit` above because that one
      // any signed-in account may append to (docs/16 R9). Every row here is
      // written by a function in the same transaction as the action it
      // records, and never changed or removed afterwards, by anyone.
      match /studioAudit/{entry} {
        allow read: if studioLevel(study) >= 1;
        allow write: if false;
      }
    }

    // Anything not named above is closed. Firestore's default is already deny,
    // but stating it means a new collection added in a hurry does not quietly
    // inherit somebody else's permissions.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
