rules_version = '2';

/*
 * Deployed by CI, since this commit.
 *
 * These rules were watched by the workflow's path filter but never handed to a
 * deploy: an edit landed on main, the run went green, and the project kept the
 * old rules. A rules file that is not deployed is a control that exists only in
 * the repository — and the gap is invisible exactly because the run passes.
 * `.github/workflows/firebase.yml` now ships them when they change.
 */

/**
 * MySelf — research project rules.
 *
 * On Postgres the access control was a role with no grant. Here it is this
 * file, so it is written to be read: every rule states who and why, and the
 * rules test suite exercises each one from both sides — the caller who should
 * pass and the caller who should not.
 *
 * Three kinds of caller:
 *   - iPads, which carry a `device` claim. They may add sittings and read
 *     nothing. A stolen device cannot read the study back.
 *   - people, who carry a `role` claim of owner, researcher or analyst.
 *   - everybody else, who gets nothing.
 *
 * Participants never authenticate at all: the iPad is the authenticated party,
 * not the child using it.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isDevice() {
      return signedIn() && request.auth.token.get('device', false) == true;
    }

    // A person, as opposed to an iPad. Devices are deliberately excluded from
    // every read path below by this distinction.
    function isPerson() {
      return signedIn() && !isDevice() && role() in ['owner', 'researcher', 'analyst'];
    }

    function canWrite() {
      return role() in ['owner', 'researcher'];
    }

    function isOwner() {
      return role() == 'owner';
    }

    // The device's own study, so one site's iPad cannot post into another's.
    function deviceStudy() {
      return request.auth.token.get('study', '');
    }

    match /studies/{study} {

      // ── Sittings ────────────────────────────────────────────────────────
      match /sessions/{sessionId} {
        // People read; devices never do.
        allow read: if isPerson();

        // A device may create a sitting that does not exist yet, in its own
        // study, stamped with its own id. Create-only is what makes a retried
        // upload safe: the second attempt is refused rather than doubling
        // anything, and the client treats "already exists" as success.
        allow create: if isDevice()
          && study == deviceStudy()
          && request.resource.data.deviceId == request.auth.uid
          && request.resource.data.sessionId == sessionId
          && request.resource.data.study == study;

        // Only the device that created a sitting may add to it — the case
        // where a participant resumes and finishes on the same iPad. A second
        // device writing here is exactly the merge this platform must never
        // make, so it is refused at the rule and the client files a quarantine
        // record instead.
        allow update: if isDevice()
          && resource.data.deviceId == request.auth.uid
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.releaseHash == resource.data.releaseHash;

        // Researchers may mark a sitting quarantined, and nothing else about
        // it. The raw log is the record; no person edits it, ever.
        allow update: if canWrite()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quarantined']);

        // Nobody deletes. Withdrawal is a documented workflow that writes a
        // tombstone, not an ad-hoc delete from a console.
        allow delete: if false;

        match /chunks/{chunk} {
          allow read: if isPerson();
          allow create: if isDevice() && study == deviceStudy();
          allow update, delete: if false;
        }
      }

      // ── Quarantine ──────────────────────────────────────────────────────
      // A device whose write was refused files the copy it was holding here,
      // so both versions survive and a human can compare them.
      match /quarantine/{entry} {
        allow read: if isPerson();
        allow create: if isDevice() && study == deviceStudy();
        allow update: if canWrite();
        allow delete: if false;
      }

      // ── Corrections and twin splits ─────────────────────────────────────
      // Both change who a sitting belongs to, so both are researcher-level and
      // both are append-then-withdraw rather than edit-in-place: the history of
      // what was believed about a participant is itself worth keeping.
      match /corrections/{correction} {
        allow read: if isPerson();
        allow create: if canWrite() && request.resource.data.wrongCode != request.resource.data.rightCode;
        allow update: if canWrite()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawnAt', 'withdrawnBy']);
        allow delete: if false;
      }

      match /assignments/{sessionId} {
        allow read: if isPerson();
        allow write: if canWrite();
      }

      // ── Devices ─────────────────────────────────────────────────────────
      // Enrolment happens in a Cloud Function using the admin SDK, which is
      // not subject to these rules. Nothing a browser can do creates a device.
      match /devices/{deviceId} {
        allow read: if isOwner();
        allow write: if false;
      }

      // ── Audit ───────────────────────────────────────────────────────────
      // Append-only for anyone who can write, readable only by an owner. Not
      // editable by anybody, including the person who wrote the entry.
      match /audit/{entry} {
        allow read: if isOwner();
        allow create: if signedIn();
        allow update, delete: if false;
      }

      /**
       * Narrative runs — a young person's own words about their experience.
       *
       * NO CLIENT MAY WRITE ONE. They arrive through the saveNarrative
       * function, which uses the Admin SDK and so passes these rules by; that
       * is the point. A tester holding a link key is not signed in at all and
       * could not write here under any rule, and a device that could write
       * directly could also overwrite somebody else's run.
       *
       * Reading is for people, not devices: an iPad that has finished a
       * sitting has no business reading back what any child has said,
       * including the one in front of it.
       */
      match /narratives/{sessionId} {
        allow read: if isPerson();
        allow write: if false;
      }

      /**
       * Versions published from the dashboard, and which one is live (D-54).
       *
       * READABLE BY ANYONE, signed in or not. An iPad reads them at start-up,
       * before it has any credential, and a device must be able to pick up the
       * live version whether or not it can reach the study. They hold the
       * questionnaire, which is already public in the participant app's bundle,
       * and nothing about any participant.
       *
       * WRITABLE BY NO CLIENT. The dashboard's functions write them with the
       * Admin SDK, after an owner publishes, and are audited there. A version a
       * browser could write is a questionnaire anybody could put in front of a
       * child. Every reader also checks a manifest against its content hash
       * before using it, so a changed document is refused as well as blocked.
       *
       * Only `activeRelease` is opened under `config`. Anything else put there
       * later stays closed until it is written down here.
       */
      match /releases/{hash} {
        allow read: if true;
        allow write: if false;
      }

      match /config/activeRelease {
        allow read: if true;
        allow write: if false;
      }
    }

    // Anything not named above is closed. Firestore's default is already deny,
    // but stating it means a new collection added in a hurry does not quietly
    // inherit somebody else's permissions.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
