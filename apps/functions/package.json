{
  "name": "@myself/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node build-deploy.mjs",
    "grant": "node grant-role.mjs",
    "test:integration": "firebase emulators:exec --only firestore --project demo-myself --config ../../infra/firebase/firebase.test.json \"vitest run --config vitest.integration.config.ts\""
  },
  "dependencies": {
    "@myself/firebase": "workspace:*",
    "@myself/llm": "workspace:*",
    "@myself/narrative": "workspace:*",
    "@myself/schema": "workspace:*",
    "@myself/store": "workspace:*",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "firebase-tools": "^14.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
